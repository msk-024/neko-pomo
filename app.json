{
  "expo": {
    "name": "ねこポモ",
    "slug": "neko-pomo",
    "version": "1.0.0",
    "scheme": "neko-pomo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.msk024.nekopomo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F0"
      },
      "package": "com.msk024.nekopomo",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "themeColor": "#FF85A1",
      "backgroundColor": "#FFF8F0",
      "manifest": {
        "name": "ねこポモ",
        "short_name": "ねこポモ",
        "description": "猫と一緒にポモドーロ×TODOで集中しよう",
        "display": "standalone",
        "orientation": "portrait",
        "theme_color": "#FF85A1",
        "background_color": "#FFF8F0",
        "lang": "ja",
        "start_url": "/"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF85A1"
        }
      ]
    ]
  }
}
